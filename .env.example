# Copie para .env e ajuste.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Banco PostgreSQL local
DATABASE_URL=postgres://motocontrol:TROQUE_A_SENHA@localhost:5432/motocontrol

# Gere um valor aleatório longo, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=12

# Senha do usuário "admin" criado por "npm run seed" (se vazio, usa admin123 e exige troca no 1º acesso)
ADMIN_PASSWORD=

# Backups automáticos (0 desativa) e quantos manter
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=30

# Caminhos do pg_dump/pg_restore, se não estiverem no PATH (comum no Windows)
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\16\bin\pg_restore.exe
