{
  "name": "motocontrol",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema web de gerenciamento de oficinas de motocicletas (MVP, rede local)",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "migrate": "node database/migrate.js",
    "seed": "node database/seeds/seed.js",
    "seed:demo": "node database/seeds/seed.js --demo",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "setup": "node scripts/setup.js",
    "pacote": "node scripts/gerar-pacote.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "marked": "15.0.12",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
