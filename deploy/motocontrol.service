# systemd (Linux): inicia o MotoControl junto com o sistema operacional.
# 1) Ajuste User e WorkingDirectory  2) sudo cp deploy/motocontrol.service /etc/systemd/system/
# 3) sudo systemctl daemon-reload && sudo systemctl enable --now motocontrol
[Unit]
Description=MotoControl - gerenciamento de oficina
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=motocontrol
WorkingDirectory=/opt/motocontrol
ExecStart=/usr/bin/node app.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
